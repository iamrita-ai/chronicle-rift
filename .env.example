# Required service credentials — replace every placeholder locally or in Render.
BOT_TOKEN=replace-with-botfather-token
MONGODB_URI=mongodb+srv://replace-user:replace-password@replace-cluster/chronicle_rift?retryWrites=true&w=majority
GROQ_API_KEY=replace-with-groq-api-key

# Game / AI settings
GROQ_MODEL=openai/gpt-oss-20b
# Voice narration (Orpheus TTS on Groq) for the "Hear the chronicle" button.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara
MONGODB_DATABASE=chronicle_rift
RICH_MESSAGES_ENABLED=true
MINI_APP_AUTH_MAX_AGE_SECONDS=3600

# Local development defaults. Use webhook mode for Render.
BOT_MODE=polling
PORT=10000
WEBHOOK_PATH=/telegram/webhook
MINI_APP_PATH=/app

# Webhook deployment only. Render supplies RENDER_EXTERNAL_URL automatically.
# PUBLIC_BASE_URL=https://your-public-domain.example
# WEBHOOK_SECRET=replace-with-a-random-url-safe-secret
# MINI_APP_URL=https://your-public-domain.example/app

# Optional Telegram MTProto application credentials; NOT needed for the Bot API flow.
# API_ID=
# API_HASH=

# Optional access restriction, comma-separated Telegram user IDs.
# ALLOWED_USER_IDS=123456789

# Your Telegram user ID: receives every feedback note and unlocks owner test mode.
OWNER_USER_ID=

# Optional override for the source link on the bot home.
REPO_URL=https://github.com/iamrita-ai/chronicle-rift

LOG_LEVEL=INFO
